PORT=5000

# Fast2SMS API Key for real SMS delivery
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# SMTP Email Settings for sending Email OTPs & notifications
# How to get Gmail App Password:
# 1. Turn on 2-Step Verification in Google Account
# 2. Search "App Passwords" in Google Account & generate a 16-character password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
